{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "App.js",
      "use": "@vercel/static"
    },
    {
      "src": "Controller.js",
      "use": "@vercel/static"
    },
    {
      "src": "PremiumView.js",
      "use": "@vercel/static"
    },
    {
      "src": "Model.js",
      "use": "@vercel/static"
    },
    {
      "src": "PremiumModel.js",
      "use": "@vercel/static"
    },
    {
      "src": "GooglePay.js",
      "use": "@vercel/static"
    },
    {
      "src": "PremiumController.js",
      "use": "@vercel/static"
    },
    {
      "src": "View.js",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
